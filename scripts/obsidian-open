#!/usr/bin/env bash
set -euo pipefail

# obsidian-open - Open Obsidian with a folder as vault
# Usage: obsidian-open [PATH]
#   PATH: folder to open as vault (default: current directory)

show_help() {
    cat <<EOF
obsidian-open - Open Obsidian with a folder as vault

Usage:
  obsidian-open [OPTIONS] [PATH]

Options:
  -h, --help    Show this help message and exit

Arguments:
  PATH          Folder to open as Obsidian vault (default: current directory)

Description:
  Opens Obsidian note-taking app with the specified folder as a vault.
  Uses the obsidian:// URI scheme with platform-specific handlers:
    macOS: open "obsidian://open?path=..."
    Linux: xdg-open "obsidian://open?path=..."
    Windows (Git Bash/Cygwin): start "obsidian://open?path=..."

Examples:
  obsidian-open                    # Open current directory
  obsidian-open ~/notes            # Open ~/notes folder
  obsidian-open "My Notes"         # Open folder with spaces

Exit codes:
  0 - Success
  1 - Invalid argument or help requested
  2 - Unsupported operating system
  3 - Failed to open Obsidian (command not found or app not installed)
EOF
}

# Parse command line arguments
PATH_ARG=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1" >&2
            show_help >&2
            exit 1
            ;;
        *)
            if [[ -n "$PATH_ARG" ]]; then
                echo "Error: Multiple paths specified. Please provide only one path." >&2
                exit 1
            fi
            PATH_ARG="$1"
            ;;
    esac
    shift
done

# Use current directory if no path provided
if [[ -z "$PATH_ARG" ]]; then
    PATH_ARG="."
fi

# Convert to absolute path with fallback methods
get_absolute_path() {
    local path="$1"
    # Try realpath first
    if command -v realpath >/dev/null 2>&1; then
        realpath "$path" 2>/dev/null && return
    fi
    # Try Python as cross-platform fallback
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import os,sys; print(os.path.abspath(sys.argv[1]))" "$path" 2>/dev/null && return
    elif command -v python >/dev/null 2>&1; then
        python -c "import os,sys; print(os.path.abspath(sys.argv[1]))" "$path" 2>/dev/null && return
    fi
    # Last resort: use pwd for relative paths (won't resolve symlinks)
    if [[ -d "$path" ]]; then
        (cd "$path" && pwd) 2>/dev/null && return
    fi
    # If nothing works, return the original path
    echo "$path"
}

ABS_PATH=$(get_absolute_path "$PATH_ARG")
if [[ ! -e "$ABS_PATH" ]]; then
    echo "Error: Path '$PATH_ARG' does not exist or cannot be resolved." >&2
    exit 1
fi

# Verify it's a directory
if [[ ! -d "$ABS_PATH" ]]; then
    echo "Error: '$ABS_PATH' is not a directory." >&2
    exit 1
fi

# URL encode the path (keep slashes as is)
urlencode() {
    # Use Python's urllib if available, otherwise simple encoding
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"
    elif command -v python >/dev/null 2>&1; then
        python -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"
    else
        # Fallback: replace spaces with %20, and a few other common characters
        local encoded="$1"
        encoded="${encoded//%/%25}"
        encoded="${encoded// /%20}"
        encoded="${encoded//\?/%3F}"
        encoded="${encoded//#/%23}"
        encoded="${encoded//&/%26}"
        encoded="${encoded//\"/%22}"
        encoded="${encoded//\'/%27}"
        encoded="${encoded//</%3C}"
        encoded="${encoded//>/%3E}"
        echo "$encoded"
    fi
}

ENCODED_PATH=$(urlencode "$ABS_PATH")

# Construct Obsidian URI
OBSIDIAN_URI="obsidian://open?path=$ENCODED_PATH"

# Detect operating system and open URI
open_uri() {
    local uri="$1"
    case "$(uname -s)" in
        Darwin)
            if command -v open >/dev/null 2>&1; then
                open "$uri"
            else
                echo "Error: 'open' command not found (macOS)" >&2
                return 1
            fi
            ;;
        Linux)
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$uri"
            else
                echo "Error: 'xdg-open' command not found (Linux)" >&2
                return 1
            fi
            ;;
        CYGWIN*|MINGW*|MSYS*)
            if command -v start >/dev/null 2>&1; then
                start "$uri"
            else
                echo "Error: 'start' command not found (Windows)" >&2
                return 1
            fi
            ;;
        *)
            echo "Error: Unsupported operating system: $(uname -s)" >&2
            return 2
            ;;
    esac
}

echo "Opening Obsidian with vault: $ABS_PATH"
echo "URI: $OBSIDIAN_URI"

if ! open_uri "$OBSIDIAN_URI"; then
    echo "Failed to open Obsidian. Please ensure Obsidian is installed and the URI scheme is supported." >&2
    exit 3
fi

echo "Successfully opened Obsidian."